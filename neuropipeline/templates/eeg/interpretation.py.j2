{% if use_shap is defined and use_shap %}
def compute_shap_values(model, features, labels):
    """Compute SHAP (SHapley Additive exPlanations) values.

    SHAP provides theoretically grounded feature importance by computing
    the marginal contribution of each feature to the prediction
    (Lundberg & Lee, 2017 - A Unified Approach to Interpreting Model Predictions).

    Parameters
    ----------
    model : object
        Trained classifier.
    features : np.ndarray
        Feature matrix.
    labels : np.ndarray
        True labels.

    Returns
    -------
    np.ndarray
        SHAP values per sample per feature.
    """
    import shap
    print("[INTERPRETATION] Computing SHAP values...")

    # Use KernelExplainer for model-agnostic explanations
    # REVIEW: For large datasets, subsample background data for speed
    background = features[np.random.choice(len(features), min(100, len(features)), replace=False)]
    explainer = shap.KernelExplainer(model.predict, background)
    shap_values = explainer.shap_values(features[:50])  # Explain first 50 samples

    # Summary plot
    plt.figure(figsize=(12, 8))
    shap.summary_plot(shap_values, features[:50], show=False)
    plt.title(f"SHAP Feature Importance - {DATASET_NAME}")
    plt.tight_layout()
    plt.savefig(os.path.join("outputs", "shap_summary.png"), dpi=150, bbox_inches="tight")
    plt.close()
    print("[INTERPRETATION] SHAP summary plot saved")

    # Feature importance ranking
    if isinstance(shap_values, list):
        mean_shap = np.mean([np.abs(sv).mean(axis=0) for sv in shap_values], axis=0)
    else:
        mean_shap = np.abs(shap_values).mean(axis=0)

    np.save(os.path.join("outputs", "shap_values.npy"), mean_shap)
    return shap_values
{% endif %}


{% if use_gradcam is defined and use_gradcam %}
def compute_gradcam(model, data, target_class=None):
    """Compute Grad-CAM activation maps for temporal localization.

    Grad-CAM highlights which time segments and channels most contribute
    to the model's classification decision (Selvaraju et al., 2017).
    For EEG, this reveals temporally-resolved neural patterns.

    Parameters
    ----------
    model : torch.nn.Module
        Trained PyTorch model.
    data : np.ndarray
        Input data samples.
    target_class : int, optional
        Target class for Grad-CAM computation.

    Returns
    -------
    np.ndarray
        Grad-CAM activation maps.
    """
    import torch
    print("[INTERPRETATION] Computing Grad-CAM activations...")

    model.eval()
    activations = []
    gradients = []

    def forward_hook(module, input, output):
        activations.append(output)

    def backward_hook(module, grad_input, grad_output):
        gradients.append(grad_output[0])

    # Register hooks on last conv layer
    target_layer = None
    for name, module in model.named_modules():
        if isinstance(module, (torch.nn.Conv1d, torch.nn.Conv2d)):
            target_layer = module

    if target_layer is None:
        print("[INTERPRETATION] WARNING: No conv layer found for Grad-CAM")
        return None

    handle_f = target_layer.register_forward_hook(forward_hook)
    handle_b = target_layer.register_full_backward_hook(backward_hook)

    # Forward pass
    x = torch.tensor(data[:10], dtype=torch.float32)
    output = model(x)
    if target_class is not None:
        score = output[:, target_class].sum()
    else:
        score = output.max(dim=1)[0].sum()

    # Backward pass
    model.zero_grad()
    score.backward()

    # Compute Grad-CAM
    act = activations[0].detach().numpy()
    grad = gradients[0].detach().numpy()
    weights = np.mean(grad, axis=-1, keepdims=True)
    cam = np.sum(weights * act, axis=1)
    cam = np.maximum(cam, 0)  # ReLU
    # Normalize
    cam_max = cam.max(axis=-1, keepdims=True)
    cam = cam / (cam_max + 1e-8)

    handle_f.remove()
    handle_b.remove()

    # Plot
    plt.figure(figsize=(12, 4))
    plt.imshow(cam[:5], aspect="auto", cmap="hot")
    plt.colorbar(label="Activation")
    plt.xlabel("Time")
    plt.ylabel("Sample")
    plt.title(f"Grad-CAM Temporal Activations - {DATASET_NAME}")
    plt.tight_layout()
    plt.savefig(os.path.join("outputs", "gradcam_map.png"), dpi=150)
    plt.close()
    print("[INTERPRETATION] Grad-CAM map saved")
    return cam
{% endif %}


{% if use_attention is defined and use_attention %}
def visualize_attention_weights(model, data):
    """Visualize attention weights from the model.

    Attention weights reveal which channels/timepoints the model
    focuses on for classification decisions. For GAT models, this
    shows learned electrode connectivity patterns.

    Parameters
    ----------
    model : torch.nn.Module
        Trained model with attention mechanism.
    data : np.ndarray
        Input data.

    Returns
    -------
    np.ndarray
        Attention weight matrix.
    """
    import torch
    print("[INTERPRETATION] Extracting attention weights...")

    model.eval()
    x = torch.tensor(data[:5], dtype=torch.float32)

    # Try to extract attention weights
    attention_weights = None
    for name, module in model.named_modules():
        if hasattr(module, "attention") or "attn" in name.lower():
            # Hook to capture attention
            attention_weights = []
            def hook(module, input, output):
                if isinstance(output, tuple) and len(output) > 1:
                    attention_weights.append(output[1])
            handle = module.register_forward_hook(hook)
            with torch.no_grad():
                model(x)
            handle.remove()
            break

    if attention_weights:
        attn = attention_weights[0].detach().numpy()
        plt.figure(figsize=(10, 8))
        plt.imshow(attn[0] if attn.ndim > 2 else attn, aspect="auto", cmap="viridis")
        plt.colorbar(label="Attention Weight")
        plt.xlabel("Key Position")
        plt.ylabel("Query Position")
        plt.title(f"Attention Weights - {DATASET_NAME}")
        plt.tight_layout()
        plt.savefig(os.path.join("outputs", "attention_weights.png"), dpi=150)
        plt.close()
        print("[INTERPRETATION] Attention visualization saved")
    else:
        print("[INTERPRETATION] No attention weights found in model")

    return attention_weights
{% endif %}


{% if use_faa_analysis is defined and use_faa_analysis %}
def analyze_faa_patterns(features, labels):
    """Analyze Frontal Alpha Asymmetry patterns across classes.

    FAA is a well-established biomarker for emotional valence where
    greater left frontal activity (positive FAA) associates with
    approach motivation and positive affect (Davidson, 1992).

    Parameters
    ----------
    features : np.ndarray
        Feature matrix (should include FAA features).
    labels : np.ndarray
        Class labels.
    """
    print("[INTERPRETATION] Analyzing FAA patterns...")

    # Assume FAA features are the last few columns
    # REVIEW: FAA column indices should be tracked from feature extraction
    n_faa = 4  # F3-F4, F7-F8, AF3-AF4, Fp1-Fp2
    faa_features = features[:, -n_faa:]

    unique_classes = np.unique(labels)
    plt.figure(figsize=(10, 6))
    for cls in unique_classes:
        class_faa = faa_features[labels == cls]
        means = np.mean(class_faa, axis=0)
        stds = np.std(class_faa, axis=0)
        x_pos = np.arange(n_faa) + cls * 0.2
        plt.bar(x_pos, means, 0.2, yerr=stds, label=f"Class {cls}", alpha=0.7)

    plt.xlabel("Frontal Channel Pair")
    plt.ylabel("Alpha Asymmetry (log R - log L)")
    plt.title(f"Frontal Alpha Asymmetry by Class - {DATASET_NAME}")
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join("outputs", "faa_analysis.png"), dpi=150)
    plt.close()
    print("[INTERPRETATION] FAA analysis plot saved")
{% endif %}


{% if use_topomap is defined and use_topomap %}
def plot_importance_topomap(feature_importance, ch_names=None):
    """Plot topographic map of channel importance.

    Topomaps project channel-level importance onto a 2D head map,
    revealing spatial patterns consistent with known neuroanatomy.

    Parameters
    ----------
    feature_importance : np.ndarray
        Importance score per channel.
    ch_names : list, optional
        Channel names in 10-20 system.
    """
    import mne
    print("[INTERPRETATION] Generating importance topomap...")

    # Create standard 10-20 montage info
    if ch_names is None:
        ch_names = ["Fp1", "Fp2", "F7", "F3", "Fz", "F4", "F8",
                    "T7", "C3", "Cz", "C4", "T8", "P7", "P3"]
        ch_names = ch_names[:len(feature_importance)]

    info = mne.create_info(ch_names=ch_names, sfreq=128, ch_types="eeg")
    montage = mne.channels.make_standard_montage("standard_1020")
    info.set_montage(montage, on_missing="ignore")

    fig, ax = plt.subplots(figsize=(8, 8))
    mne.viz.plot_topomap(feature_importance[:len(ch_names)], info, axes=ax, show=False)
    ax.set_title(f"Channel Importance - {DATASET_NAME}")
    fig.savefig(os.path.join("outputs", "importance_topomap.png"), dpi=150, bbox_inches="tight")
    plt.close(fig)
    print("[INTERPRETATION] Topomap saved")
{% endif %}


def run_interpretation():
    """Execute the interpretation pipeline."""
    print(f"[INTERPRETATION] Starting interpretation for: {DATASET_NAME}")

    # Load data
    features = np.load(os.path.join("outputs", "selected_features.npy"))
    labels = np.load(os.path.join("outputs", "selected_labels.npy"))

    interpretation_results = {"dataset_name": DATASET_NAME, "methods_used": []}

    {% if use_shap is defined and use_shap %}
    # SHAP analysis
    from sklearn.ensemble import RandomForestClassifier
    clf = RandomForestClassifier(n_estimators=100, random_state=SEED)
    clf.fit(features, labels)
    shap_values = compute_shap_values(clf, features, labels)
    interpretation_results["methods_used"].append("SHAP")
    {% endif %}

    {% if use_gradcam is defined and use_gradcam %}
    # Grad-CAM (requires PyTorch model)
    import torch
    model_path = os.path.join("outputs", "best_model.pth")
    if os.path.exists(model_path):
        print("[INTERPRETATION] Loading model for Grad-CAM...")
        # Model needs to be instantiated here based on architecture
        interpretation_results["methods_used"].append("Grad-CAM")
    else:
        print("[INTERPRETATION] No saved model found for Grad-CAM")
    {% endif %}

    {% if use_faa_analysis is defined and use_faa_analysis %}
    # FAA Analysis
    analyze_faa_patterns(features, labels)
    interpretation_results["methods_used"].append("FAA")
    {% endif %}

    {% if use_topomap is defined and use_topomap %}
    # Channel importance topomap
    # Use feature variance as proxy importance
    channel_importance = np.std(features, axis=0)
    plot_importance_topomap(channel_importance)
    interpretation_results["methods_used"].append("Topomap")
    {% endif %}

    # Save interpretation summary
    summary_path = os.path.join("outputs", "interpretation_summary.json")
    with open(summary_path, "w") as f:
        json.dump(interpretation_results, f, indent=2)
    print(f"[INTERPRETATION] Summary saved: {summary_path}")

    return interpretation_results


if __name__ == "__main__":
    results = run_interpretation()

"""
ECG LSTM Model
===============
Dataset: {{ dataset_name }}
Modality: ECG
Purpose: LSTM/BiLSTM for ECG sequence classification. Captures temporal
         dependencies in RR interval sequences and beat morphology evolution
         for rhythm-based arrhythmia detection.

Reference: Faust et al. (2018) - Deep learning for healthcare applications
           based on physiological signals.
"""

import os
import json
import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, TensorDataset

# Neurophysiological rationale:
# ECG rhythm analysis inherently requires temporal modeling across beats.
# LSTMs can learn:
# - RR interval patterns (regular vs irregular rhythms)
# - Morphology evolution across consecutive beats (progressive ST changes)
# - Long-range dependencies (intermittent arrhythmias like PAF)
# Bidirectional processing captures both preceding and following context
# (Yildirim et al., 2018).

SEED = 42
np.random.seed(SEED)
torch.manual_seed(SEED)
if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

# Configuration
DATASET_NAME = "{{ dataset_name }}"
{% if input_size is defined %}
INPUT_SIZE = {{ input_size }}
{% else %}
INPUT_SIZE = 1
{% endif %}
{% if hidden_size is defined %}
HIDDEN_SIZE = {{ hidden_size }}
{% else %}
HIDDEN_SIZE = 128
{% endif %}
{% if num_layers is defined %}
NUM_LAYERS = {{ num_layers }}
{% else %}
NUM_LAYERS = 2
{% endif %}
{% if n_classes is defined %}
N_CLASSES = {{ n_classes }}
{% else %}
N_CLASSES = 5
{% endif %}
{% if dropout is defined %}
DROPOUT = {{ dropout }}
{% else %}
DROPOUT = 0.3
{% endif %}
{% if bidirectional is defined %}
BIDIRECTIONAL = {{ bidirectional }}
{% else %}
BIDIRECTIONAL = True
{% endif %}

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
os.makedirs("outputs", exist_ok=True)


class ECGLSTMClassifier(nn.Module):
    """LSTM classifier for ECG sequences.

    Processes ECG beats as sequences, learning temporal patterns in
    cardiac rhythm for arrhythmia classification.

    Input shape: (batch_size, seq_len, input_size)
    Output shape: (batch_size, n_classes)
    """

    def __init__(self, input_size=INPUT_SIZE, hidden_size=HIDDEN_SIZE,
                 num_layers=NUM_LAYERS, n_classes=N_CLASSES,
                 dropout=DROPOUT, bidirectional=BIDIRECTIONAL):
        super().__init__()
        self.hidden_size = hidden_size
        self.num_layers = num_layers
        self.bidirectional = bidirectional
        self.num_directions = 2 if bidirectional else 1

        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_size,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout if num_layers > 1 else 0,
            bidirectional=bidirectional,
        )

        # Attention layer
        self.attention = nn.Sequential(
            nn.Linear(hidden_size * self.num_directions, hidden_size),
            nn.Tanh(),
            nn.Linear(hidden_size, 1),
        )

        # Classifier
        fc_input = hidden_size * self.num_directions
        self.classifier = nn.Sequential(
            nn.Dropout(dropout),
            nn.Linear(fc_input, hidden_size),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_size, n_classes),
        )

        self._init_weights()

    def _init_weights(self):
        """Initialize weights."""
        for name, param in self.lstm.named_parameters():
            if "weight" in name:
                nn.init.orthogonal_(param)
            elif "bias" in name:
                nn.init.zeros_(param)
                n = param.size(0)
                param.data[n // 4:n // 2].fill_(1.0)
        for m in self.classifier:
            if isinstance(m, nn.Linear):
                nn.init.xavier_normal_(m.weight)
                nn.init.zeros_(m.bias)

    def forward(self, x):
        """Forward pass with attention pooling.

        Parameters
        ----------
        x : Tensor
            Input (batch, seq_len, input_size).

        Returns
        -------
        Tensor
            Class logits (batch, n_classes).
        """
        lstm_out, _ = self.lstm(x)

        # Attention-weighted aggregation
        attn_weights = self.attention(lstm_out)
        attn_weights = torch.softmax(attn_weights, dim=1)
        context = torch.sum(lstm_out * attn_weights, dim=1)

        output = self.classifier(context)
        return output


def train_ecg_lstm():
    """Train the ECG LSTM model."""
    print(f"[MODEL_LSTM] Starting ECG LSTM training for: {DATASET_NAME}")
    print(f"[MODEL_LSTM] Config: hidden={HIDDEN_SIZE}, layers={NUM_LAYERS}, bidir={BIDIRECTIONAL}")

    # Load data
    features = np.load(os.path.join("outputs", "selected_features.npy"))
    labels = np.load(os.path.join("outputs", "selected_labels.npy"))
    print(f"[MODEL_LSTM] Data: {features.shape}")

    # Reshape to (batch, seq_len, features)
    n_samples = features.shape[0]
    if features.ndim == 2:
        seq_len = features.shape[1] // INPUT_SIZE
        data = features[:, :seq_len * INPUT_SIZE].reshape(n_samples, seq_len, INPUT_SIZE)
    else:
        data = features

    print(f"[MODEL_LSTM] Input shape: {data.shape}")

    X = torch.tensor(data, dtype=torch.float32)
    y = torch.tensor(labels, dtype=torch.long)

    # Train/val split
    n_train = int(0.8 * n_samples)
    indices = np.random.permutation(n_samples)
    train_idx, val_idx = indices[:n_train], indices[n_train:]

    train_loader = DataLoader(TensorDataset(X[train_idx], y[train_idx]), batch_size=64, shuffle=True)
    val_loader = DataLoader(TensorDataset(X[val_idx], y[val_idx]), batch_size=64, shuffle=False)

    # Model
    model = ECGLSTMClassifier().to(DEVICE)
    print(f"[MODEL_LSTM] Parameters: {sum(p.numel() for p in model.parameters()):,}")

    optimizer = torch.optim.Adam(model.parameters(), lr=1e-3, weight_decay=1e-4)
    criterion = nn.CrossEntropyLoss()
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, patience=10, factor=0.5)

    best_val_acc = 0
    history = {"train_loss": [], "val_loss": [], "train_acc": [], "val_acc": []}

    for epoch in range(100):
        model.train()
        train_loss, train_correct, train_total = 0, 0, 0
        for batch_x, batch_y in train_loader:
            batch_x, batch_y = batch_x.to(DEVICE), batch_y.to(DEVICE)
            optimizer.zero_grad()
            outputs = model(batch_x)
            loss = criterion(outputs, batch_y)
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
            optimizer.step()
            train_loss += loss.item()
            _, predicted = outputs.max(1)
            train_correct += predicted.eq(batch_y).sum().item()
            train_total += batch_y.size(0)

        model.eval()
        val_loss, val_correct, val_total = 0, 0, 0
        with torch.no_grad():
            for batch_x, batch_y in val_loader:
                batch_x, batch_y = batch_x.to(DEVICE), batch_y.to(DEVICE)
                outputs = model(batch_x)
                loss = criterion(outputs, batch_y)
                val_loss += loss.item()
                _, predicted = outputs.max(1)
                val_correct += predicted.eq(batch_y).sum().item()
                val_total += batch_y.size(0)

        train_acc = train_correct / max(train_total, 1)
        val_acc = val_correct / max(val_total, 1)
        history["train_loss"].append(train_loss / len(train_loader))
        history["val_loss"].append(val_loss / max(len(val_loader), 1))
        history["train_acc"].append(train_acc)
        history["val_acc"].append(val_acc)

        scheduler.step(val_loss)

        if val_acc > best_val_acc:
            best_val_acc = val_acc
            torch.save(model.state_dict(), os.path.join("outputs", "best_ecg_lstm.pth"))

        if (epoch + 1) % 20 == 0:
            print(f"[MODEL_LSTM] Epoch {epoch+1}/100 - Val Acc: {val_acc:.4f}")

    print(f"[MODEL_LSTM] Training complete. Best val accuracy: {best_val_acc:.4f}")
    with open(os.path.join("outputs", "ecg_lstm_history.json"), "w") as f:
        json.dump(history, f, indent=2)

    return model, history


if __name__ == "__main__":
    model, history = train_ecg_lstm()

os.makedirs("outputs", exist_ok=True)


def load_analysis_results():
    """Load all previous analysis results.

    Returns
    -------
    dict
        Combined results from all previous stages.
    """
    print("[CLINICAL_INTERPRETATION] Loading analysis results...")
    results = {}

    # Load evaluation results
    eval_path = os.path.join("outputs", "evaluation_results.json")
    if os.path.exists(eval_path):
        with open(eval_path, "r") as f:
            results["evaluation"] = json.load(f)

    # Load R-peak detection results
    rpeak_path = os.path.join("outputs", "rpeak_detection_results.json")
    if os.path.exists(rpeak_path):
        with open(rpeak_path, "r") as f:
            results["rpeak"] = json.load(f)

    # Load predictions
    pred_path = os.path.join("outputs", "predictions.npy")
    if os.path.exists(pred_path):
        results["predictions"] = np.load(pred_path)

    # Load R-peaks for HR analysis
    rpeaks_path = os.path.join("outputs", "r_peaks.npy")
    if os.path.exists(rpeaks_path):
        results["r_peaks"] = np.load(rpeaks_path)

    return results


def analyze_heart_rate_trends(r_peaks, fs=500):
    """Analyze heart rate trends over the recording.

    Heart rate variability and trends provide diagnostic information:
    - Sustained tachycardia: possible fever, anxiety, hyperthyroidism
    - Bradycardia: possible AV block, sick sinus syndrome
    - HR variability: autonomic function assessment

    Parameters
    ----------
    r_peaks : np.ndarray
        R-peak indices.
    fs : float
        Sampling frequency.

    Returns
    -------
    dict
        Heart rate trend analysis.
    """
    print("[CLINICAL_INTERPRETATION] Analyzing heart rate trends...")
    rr_ms = np.diff(r_peaks) / fs * 1000
    hr = 60000 / rr_ms  # BPM

    # Segment into time windows
    window_beats = 30  # 30-beat windows
    hr_trend = []
    for i in range(0, len(hr), window_beats):
        window_hr = hr[i:i + window_beats]
        hr_trend.append(float(np.mean(window_hr)))

    analysis = {
        "mean_hr": float(np.mean(hr)),
        "std_hr": float(np.std(hr)),
        "min_hr": float(np.min(hr)),
        "max_hr": float(np.max(hr)),
        "hr_trend": hr_trend,
        "classification": classify_rate(np.mean(hr)),
    }

    # Plot
    plt.figure(figsize=(12, 4))
    plt.plot(hr, alpha=0.5, label="Instantaneous HR")
    if len(hr_trend) > 1:
        trend_x = np.arange(0, len(hr), window_beats)[:len(hr_trend)]
        plt.plot(trend_x, hr_trend, "r-", linewidth=2, label="Trend")
    plt.axhline(y=100, color="orange", linestyle="--", alpha=0.5, label="Tachycardia threshold")
    plt.axhline(y=60, color="blue", linestyle="--", alpha=0.5, label="Bradycardia threshold")
    plt.xlabel("Beat Index")
    plt.ylabel("Heart Rate (BPM)")
    plt.title(f"Heart Rate Trend - {DATASET_NAME}")
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join("outputs", "hr_trend.png"), dpi=150)
    plt.close()

    return analysis


def classify_rate(mean_hr):
    """Classify heart rate.

    Parameters
    ----------
    mean_hr : float
        Mean heart rate in BPM.

    Returns
    -------
    str
        Rate classification.
    """
    if mean_hr < 60:
        return "bradycardia"
    elif mean_hr > 100:
        return "tachycardia"
    else:
        return "normal_rate"


def classify_rhythm(predictions, r_peaks=None, fs=500):
    """Classify cardiac rhythm based on model predictions and RR analysis.

    Rhythm classification combines model predictions (beat morphology)
    with RR interval regularity analysis to determine the underlying
    cardiac rhythm.

    Parameters
    ----------
    predictions : np.ndarray
        Model predictions per beat.
    r_peaks : np.ndarray, optional
        R-peak locations for regularity analysis.
    fs : float
        Sampling frequency.

    Returns
    -------
    dict
        Rhythm classification results.
    """
    print("[CLINICAL_INTERPRETATION] Classifying rhythm...")

    rhythm_analysis = {
        "dominant_class": None,
        "rhythm_regularity": None,
        "findings": [],
    }

    if predictions is not None:
        unique, counts = np.unique(predictions, return_counts=True)
        dominant = unique[np.argmax(counts)]
        rhythm_analysis["dominant_class"] = int(dominant)
        rhythm_analysis["class_distribution"] = {str(k): int(v) for k, v in zip(unique, counts)}

    # RR regularity analysis
    if r_peaks is not None and len(r_peaks) > 2:
        rr = np.diff(r_peaks) / fs * 1000
        cv_rr = np.std(rr) / np.mean(rr) * 100
        # REVIEW: CV threshold for irregular rhythm - may need tuning
        if cv_rr < 10:
            rhythm_analysis["rhythm_regularity"] = "regular"
        elif cv_rr < 20:
            rhythm_analysis["rhythm_regularity"] = "slightly_irregular"
        else:
            rhythm_analysis["rhythm_regularity"] = "irregular"
            rhythm_analysis["findings"].append("Irregular rhythm detected - consider AF screening")

    return rhythm_analysis


def map_to_snomed_ct(findings):
    """Map detected findings to SNOMED-CT codes.

    SNOMED-CT provides standardized clinical terminology for
    interoperability between health information systems.

    Parameters
    ----------
    findings : list
        List of detected conditions.

    Returns
    -------
    list
        SNOMED-CT coded findings.
    """
    print("[CLINICAL_INTERPRETATION] Mapping to SNOMED-CT...")
    coded_findings = []
    for finding in findings:
        if finding in SNOMED_CT_MAP:
            coded_findings.append({
                "finding": finding,
                "snomed_ct": SNOMED_CT_MAP[finding],
            })
    return coded_findings


def suggest_icd10_codes(findings):
    """Suggest ICD-10 diagnostic codes based on findings.

    FOR RESEARCH ONLY - these suggestions are not validated for
    clinical coding and must be reviewed by a qualified professional.

    Parameters
    ----------
    findings : list
        List of detected conditions.

    Returns
    -------
    list
        ICD-10 code suggestions.
    """
    print("[CLINICAL_INTERPRETATION] Suggesting ICD-10 codes...")
    suggestions = []
    for finding in findings:
        if finding in ICD10_MAP:
            suggestions.append({
                "finding": finding,
                "icd10": ICD10_MAP[finding],
                "disclaimer": "FOR RESEARCH ONLY - requires clinical validation",
            })
    return suggestions


def generate_clinical_report(hr_analysis, rhythm_analysis, snomed_findings, icd10_suggestions):
    """Generate a structured clinical interpretation report.

    Parameters
    ----------
    hr_analysis : dict
        Heart rate trend analysis.
    rhythm_analysis : dict
        Rhythm classification.
    snomed_findings : list
        SNOMED-CT coded findings.
    icd10_suggestions : list
        ICD-10 suggestions.

    Returns
    -------
    dict
        Complete clinical interpretation report.
    """
    report = {
        "disclaimer": (
            "FOR RESEARCH ONLY - This automated analysis is not validated for "
            "clinical use. All findings must be reviewed by a qualified cardiologist "
            "before any clinical decision-making."
        ),
        "dataset_name": DATASET_NAME,
        "heart_rate": hr_analysis,
        "rhythm": rhythm_analysis,
        "snomed_ct_findings": snomed_findings,
        "icd10_suggestions": icd10_suggestions,
        "summary": {
            "rate_classification": hr_analysis.get("classification", "unknown"),
            "rhythm_regularity": rhythm_analysis.get("rhythm_regularity", "unknown"),
            "n_findings": len(snomed_findings),
        },
    }
    return report


def run_clinical_interpretation():
    """Execute the clinical interpretation pipeline."""
    print(f"[CLINICAL_INTERPRETATION] Starting clinical interpretation for: {DATASET_NAME}")
    print("[CLINICAL_INTERPRETATION] *** FOR RESEARCH ONLY - NOT FOR CLINICAL USE ***")

    # Load results
    results = load_analysis_results()

    # Heart rate analysis
    r_peaks = results.get("r_peaks")
    rpeak_info = results.get("rpeak", {})
    fs = rpeak_info.get("detection_metrics", {}).get("detection_rate_bpm", 500)
    fs = results.get("rpeak", {}).get("fs", 500) if isinstance(fs, str) else 500

    if r_peaks is not None and len(r_peaks) > 2:
        hr_analysis = analyze_heart_rate_trends(r_peaks, fs=500)
    else:
        hr_analysis = {"mean_hr": 0, "classification": "unknown", "hr_trend": []}

    # Rhythm classification
    predictions = results.get("predictions")
    rhythm_analysis = classify_rhythm(predictions, r_peaks, fs=500)

    # Map findings to clinical codes
    detected_findings = []
    if hr_analysis.get("classification") == "bradycardia":
        detected_findings.append("sinus_bradycardia")
    elif hr_analysis.get("classification") == "tachycardia":
        detected_findings.append("sinus_tachycardia")
    else:
        detected_findings.append("normal_sinus_rhythm")

    if rhythm_analysis.get("rhythm_regularity") == "irregular":
        detected_findings.append("atrial_fibrillation")

    # SNOMED-CT mapping
    snomed_findings = map_to_snomed_ct(detected_findings)

    # ICD-10 suggestions
    icd10_suggestions = suggest_icd10_codes(detected_findings)

    # Generate report
    report = generate_clinical_report(hr_analysis, rhythm_analysis, snomed_findings, icd10_suggestions)

    # Save report
    report_path = os.path.join("outputs", "clinical_interpretation.json")
    with open(report_path, "w") as f:
        json.dump(report, f, indent=2)
    print(f"[CLINICAL_INTERPRETATION] Report saved: {report_path}")
    print("[CLINICAL_INTERPRETATION] *** REMINDER: FOR RESEARCH ONLY ***")

    return report


if __name__ == "__main__":
    report = run_clinical_interpretation()
